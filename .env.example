# POLAD CHARKHESH â€” ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# DO NOT COMMIT REAL SECRETS TO REPOSITORIES.
# Copy to .env, fill values, then run: node --env-file=.env dist/server.cjs
# Or supply these variables through your process manager. npm start does not load .env.

# Deployment Environment
NODE_ENV=production
PORT=3000
HOST=127.0.0.1

# Database Persistence
DATABASE_PATH=data/poladcharkhesh.db

# Security & Session Secrets (Mandatory in production)
COOKIE_SECRET=
SESSION_SECRET=
SESSION_TTL_HOURS=12

# Google Search Console Verification (Optional)
VITE_GOOGLE_SITE_VERIFICATION=

# CDN / Asset URL Base (Optional)
VITE_ASSET_BASE_URL=
