# ==============================================================================
# POLAD CHARKHESH — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# DO NOT COMMIT REAL SECRETS TO REPOSITORIES.
# Copy this file to .env and fill in values for your production deployment.

# Deployment Environment
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Database Persistence
DATABASE_PATH=data/poladcharkhesh.sqlite

# Security & Session Secrets (Mandatory in production)
COOKIE_SECRET=
SESSION_SECRET=
SESSION_TTL_HOURS=12

# Google Search Console Verification (Optional)
VITE_GOOGLE_SITE_VERIFICATION=

# CDN / Asset URL Base (Optional)
VITE_ASSET_BASE_URL=
